# OpenAI, or any OpenAI-compatible chat API.
# Leave OPENAI_API_KEY empty to use the built-in instruction parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set this to swap providers (OpenRouter, Groq, Ollama, etc.).
# Example: https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# PayPal REST app credentials. Sandbox is the default and the intended mode.
# PAYPAL_SECRET is accepted as an alias for PAYPAL_CLIENT_SECRET.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Webhook id from the PayPal app (Apps & Credentials → your app → Webhooks).
# Required for real INVOICING.INVOICE.PAID deliveries. Not used by demo mode.
PAYPAL_WEBHOOK_ID=

# Shown on the PayPal invoice. Email is optional; omit it unless it is the
# sandbox business account's email, or PayPal may reject the invoice.
PAYPAL_BUSINESS_NAME=Splitnote Studio
PAYPAL_INVOICER_GIVEN_NAME=Alex
PAYPAL_INVOICER_SURNAME=Rivera
PAYPAL_INVOICER_EMAIL=

# SQLite file. On a read-only filesystem the app falls back to /tmp/splitnote.db.
DATABASE_PATH=data/splitnote.db

# Posts a local INVOICING.INVOICE.PAID and then a real sandbox payout.
# Set to false on any public deployment.
DEMO_MODE=true
